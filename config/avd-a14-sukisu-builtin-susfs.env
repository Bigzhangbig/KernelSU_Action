CONFIG_ENV=config/avd-a14-sukisu-builtin-susfs.env

KERNEL_SOURCE=https://github.com/aosp-mirror/kernel_common
KERNEL_SOURCE_BRANCH=android14-6.1
KERNEL_CONFIG=gki_defconfig
KERNEL_IMAGE_NAME=Image
ARCH=arm64
KERNEL_NAME=

CLANG_BRANCH=main-kernel-build-2024
CLANG_VERSION=r510928
USE_LLVM=true
ENABLE_GCC_ARM64=false
ENABLE_GCC_ARM32=false
EXTRA_CMDS:
CUSTOM_CMDS:

KSU_VARIANT=sukisu-ultra
KSU_REF=builtin
KSU_HOOK_MODE=auto
ENABLE_KPM=true

ENABLE_SUSFS=false
SUSFS_BRANCH=auto
ENABLE_PATH_UMOUNT=false
ENABLE_HIDE_STUFF=false

ADD_OVERLAYFS_CONFIG=true
ADD_KPROBES_CONFIG=true
DISABLE_LTO=false
DISABLE_CC_WERROR=false

EXTRA_DEFCONFIG=CONFIG_VIRTIO=y CONFIG_VIRTIO_PCI=y CONFIG_VIRTIO_PCI_LEGACY=y CONFIG_VIRTIO_PCI_MODERN_DEV=y CONFIG_VIRTIO_BALLOON=y CONFIG_VIRTIO_BLK=y CONFIG_VIRTIO_NET=y CONFIG_VIRTIO_CONSOLE=y CONFIG_VIRTIO_INPUT=y CONFIG_DRM_VIRTIO_GPU=y CONFIG_GOLDFISH_PIPE=y CONFIG_GOLDFISH_SYNC=y CONFIG_GOLDFISH_BATTERY=y CONFIG_KSU_SUSFS=y CONFIG_KSU_SUSFS_SUS_PATH=y CONFIG_KSU_SUSFS_SUS_MOUNT=y CONFIG_KSU_SUSFS_SUS_KSTAT=y CONFIG_KSU_SUSFS_SPOOF_UNAME=y CONFIG_KSU_SUSFS_ENABLE_LOG=y CONFIG_KSU_SUSFS_HIDE_KSU_SUSFS_SYMBOLS=y CONFIG_KSU_SUSFS_SPOOF_CMDLINE_OR_BOOTCONFIG=y CONFIG_KSU_SUSFS_OPEN_REDIRECT=y CONFIG_KSU_SUSFS_SUS_MAP=y CONFIG_TMPFS_XATTR=y CONFIG_TMPFS_POSIX_ACL=y

NEED_DTBO=false
BUILD_BOOT_IMG=false
SOURCE_BOOT_IMAGE=

ENABLE_CCACHE=true
REMOVE_UNUSED_PACKAGES=true
